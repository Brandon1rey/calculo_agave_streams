{
  "name": "agave-dashboard",
  "version": "2.0.0",
  "private": true,
  "description": "Dashboard para controlar campañas de ingreso de agave y medir merma / aprovechamiento. Node + PostgreSQL (Supabase), desplegable en Vercel, con modo sin conexión de solo lectura.",
  "main": "scripts/dev-server.js",
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "start": "node scripts/dev-server.js",
    "db:schema": "node scripts/apply-schema.js",
    "db:import": "node scripts/import-json.js",
    "test": "node tests/engine.test.js && node tests/offline-client.test.js",
    "test:engine": "node tests/engine.test.js",
    "test:offline": "node tests/offline-client.test.js"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
