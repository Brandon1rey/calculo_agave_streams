# Copia este archivo como .env.local y pega tus valores reales.
#   .env.local está en .gitignore: NUNCA se sube al repositorio.
#
# 1) DATABASE_URL  (obligatoria)
#    Supabase → Project Settings → Database → Connection string → URI
#    Usa la cadena del POOLER (puerto 6543, "Transaction pooler"): es la que
#    funciona bien en funciones serverless. Reemplaza [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.TU_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres

# 2) Contraseña de la app (opcional pero MUY recomendada si la publicas)
#    Si defines APP_PASSWORD, la API exige entrar una vez con:
#      https://TU-APP.vercel.app/?k=TU_CONTRASEÑA
#    y deja una cookie firmada de 90 días. Sin esta variable la app queda abierta.
# APP_PASSWORD=
# AUTH_SECRET=una-cadena-larga-y-aleatoria-para-firmar-la-cookie

# 3) Ajustes opcionales
# PGSSLMODE=require        # 'disable' para Postgres local sin TLS
# PG_POOL_MAX=3            # conexiones por instancia de función
# PORT=3053                # servidor local
# HOST=127.0.0.1           # 0.0.0.0 para exponerlo en tu red local
# NO_BROWSER=1             # no abrir el navegador al arrancar en local
